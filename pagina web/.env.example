# ===== FitBook - variables de entorno (plantilla, SIN secretos reales) =====
# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
PORT=3000

# Secreto para firmar JWT. Obligatorio en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=8h

# Base de datos PostgreSQL. Si se deja vacío, se usa PostgreSQL embebido (PGlite)
# guardado en disco en PGLITE_DIR (solo para desarrollo local).
DATABASE_URL=
# postgres://usuario:password@host:5432/fitbook
DATABASE_SSL=false
PGLITE_DIR=./data/pgdata

# Inserta datos de prueba al arrancar si la base de datos está vacía
SEED_ON_START=true

# Coste de bcrypt (10-14 recomendado)
BCRYPT_ROUNDS=12

# Solo si el frontend se sirve desde OTRO dominio (separado del backend)
CORS_ORIGIN=
# strict | lax | none  (usa none + HTTPS solo si frontend y backend están en dominios distintos)
COOKIE_SAMESITE=strict
